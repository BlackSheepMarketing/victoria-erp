# ── Servidor ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Origen del frontend para CORS (coma-separado si son varios)
CORS_ORIGINS=http://localhost:5173

# ── Base de datos MySQL ─────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=victoria
DB_PASSWORD=cambia_esto
DB_NAME=victoria_erp
# En dev puedes usar sincronizacion automatica; en produccion SIEMPRE false (usar migraciones)
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ── JWT ─────────────────────────────────────────────────
JWT_SECRET=pon_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=otro_secreto_distinto_y_largo
JWT_REFRESH_EXPIRES_IN=7d

# ── Correo (Fase 4 - send-invoice-email) ────────────────
# MAIL_PROVIDER=smtp | resend | sendgrid
MAIL_PROVIDER=smtp
MAIL_FROM="Productos Victoria <no-reply@productosvictoria.do>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
